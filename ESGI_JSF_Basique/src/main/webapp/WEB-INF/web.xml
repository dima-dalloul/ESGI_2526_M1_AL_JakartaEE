<?xml version="1.0" encoding="UTF-8" ?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
         https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

  <!-- Welcome file, votre fichier d'accueil -->
  <welcome-file-list>
    <welcome-file>home.xhtml</welcome-file>
  </welcome-file-list>

  <display-name>JSF Basique ESGI M1 AL</display-name>

  <!--
     FacesServlet est le servlet principal chargé de traiter toutes les requêtes.
     Il agit comme un contrôleur central.
     Ce servlet initialise les composants JSF avant l'affichage du JSP.
  -->

  <!-- Servlet JSF -->
  <servlet>
    <servlet-name>Faces Servlet</servlet-name>
    <servlet-class>jakarta.faces.webapp.FacesServlet</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>

  <servlet-mapping>
    <servlet-name>Faces Servlet</servlet-name>
    <url-pattern>*.xhtml</url-pattern>
  </servlet-mapping>
</web-app>